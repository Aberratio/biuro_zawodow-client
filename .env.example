# GitHub Actions configuration for the frontend repository.
# Set these separately in GitHub Environments: staging and production.
# This is not a runtime .env file: the deployed frontend is static and all
# VITE_* values are embedded into the public JavaScript bundle during build.

# Frontend build and health check
API_URL=
FRONTEND_URL=
VITE_SMARTLOOK_ENABLED=false
VITE_SMARTLOOK_PROJECT_KEY=
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Optional Sentry source map upload. Configure all three or leave all empty.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Staging only. This password is embedded in the frontend bundle and is not a
# security boundary; use it only as a convenience gate.
VITE_STAGING_GATE_PASSWORD=

# FTP deploy
FTP_SERVER=ftp.example.com
FTP_USERNAME=ftp_user
FTP_PASSWORD=ftp_password
FTP_SERVER_DIR=/domains/example.com/public_html/

# SSH deploy
SSH_HOST=ssh.example.com
SSH_PORT=22
SSH_USER=ssh_user
SSH_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----
FRONTEND_REMOTE_DIR=domains/example.com/public_html
FRONTEND_ALLOWED_ROOT=/home/example/domains/example.com/public_html
