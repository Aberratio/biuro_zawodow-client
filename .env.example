# GitHub Actions environment secrets required for frontend build.
# Set these separately in GitHub Environments: staging and production.
API_URL=
FRONTEND_URL=
VITE_SMARTLOOK_ENABLED=true
VITE_SMARTLOOK_PROJECT_KEY=
VITE_LEGAL_ADMIN_NAME=
VITE_LEGAL_ADMIN_ADDRESS=
VITE_LEGAL_CONTACT_EMAIL=

# GitHub Actions secrets required for FTP deploy:
FTP_SERVER=ftp.example.com
FTP_USERNAME=ftp_user
FTP_PASSWORD=ftp_password
FTP_SERVER_DIR=/domains/example.com/public_html/

# GitHub Actions secrets required for SSH deploy:
SSH_HOST=ssh.example.com
SSH_PORT=22
SSH_USER=ssh_user
SSH_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----
FRONTEND_REMOTE_DIR=domains/example.com/public_html
FRONTEND_ALLOWED_PATH_FRAGMENT=example.com
